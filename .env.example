# EINORT-Commerce — development environment template.
#
# Copy to `.env.local` (gitignored) and fill in real values.
# Every key here is validated at boot by `src/env.ts`; a missing or blank
# required value is a named startup error, never a silent runtime failure.

# --- Database (Neon) ---------------------------------------------------------
# Neon console -> your project -> Connection string.
# DATABASE_URL is the POOLED string (host contains `-pooler`). The app uses this
# at runtime; the pooler is what keeps serverless concurrency from exhausting
# Postgres connection limits.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# DIRECT_URL is the UNPOOLED string (same host without `-pooler`). Migrations
# only — `prisma migrate` cannot run through a transaction pooler.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# --- Hostname resolution -----------------------------------------------------
# The root/apex domain. Sole input to hostname classification: every incoming
# Host header is either this (the platform) or `{slug}.{this}` (a tenant).
# Blank or wrong here means every storefront resolves as the root domain.
# Dev: localhost:3000   Production: einort.com
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# --- Auth (Better Auth) ------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 32
# Rotating this invalidates every existing session.
BETTER_AUTH_SECRET=""

# Apex origin Better Auth issues cookies and callback URLs against.
# Dev: http://localhost:3000   Production: https://einort.com
BETTER_AUTH_URL="http://localhost:3000"

# --- Cache / rate limiting (Upstash) ----------------------------------------
# Upstash console -> your Redis database -> REST API.
# OPTIONAL in development: when unset, tenant resolution degrades to a direct
# DB read (loudly — it logs a warning). Required in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Object storage (Cloudflare R2) ------------------------------------------
# ALL FIVE ARE REQUIRED, in every environment including local dev.
#
# There is no fallback storage path: product images (CAT-02) and payment-claim
# screenshots (CHK-04) upload direct-to-R2 through a presigned PUT. A missing
# bucket does not degrade the product, it makes product creation impossible —
# so `src/env.ts` fails at boot with a named error rather than on a merchant's
# first upload.
#
# One-time setup: Cloudflare Dashboard -> R2 -> Create bucket (any region).

# Cloudflare Dashboard -> R2 -> Overview (Account ID, in the right-hand rail).
# Also the host of the S3 endpoint: https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ACCOUNT_ID=""

# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API token.
# Permission: "Object Read & Write", scoped to the single bucket below.
# The secret is displayed exactly once at creation — capture it then.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Cloudflare Dashboard -> R2 -> the bucket's name.
R2_BUCKET="einort-media"

# Cloudflare Dashboard -> R2 -> bucket -> Settings -> Public Development URL
# (a `https://pub-<hash>.r2.dev` origin), or a custom domain bound to the bucket.
# Origin only, no trailing slash — object URLs are built as {this}/{key}.
R2_PUBLIC_BASE_URL=""

# --- Transactional email (Resend) --------------------------------------------
# BOTH OPTIONAL, in every environment.
#
# These buy exactly one thing: the proactive merchant email when a customer
# submits a payment claim (D-13). The in-app claims badge is the reliable
# channel and does not depend on them. Requiring them would let an expired
# Resend key take claim submission offline — so when they are unset the claim
# path logs a warning and carries on.

# Resend Dashboard -> API Keys.
RESEND_API_KEY=""

# Resend Dashboard -> Domains. Must be a VERIFIED sending domain, otherwise
# Resend rejects the send at delivery time rather than at boot.
RESEND_FROM_EMAIL=""
