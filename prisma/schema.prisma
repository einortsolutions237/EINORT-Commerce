// EINORT-Commerce data model.
//
// Prisma 7: `datasource db` deliberately carries NO `url`. Connection config
// lives in `prisma.config.ts` and the runtime client is bound to
// `@prisma/adapter-pg` in `src/server/db/base.ts`. Putting a `url` back here
// silently does nothing (Pitfall 9).
//
// The Better Auth blocks below (User, Session, Account, Verification,
// Organization, Member, Invitation) were emitted by `npx auth generate`
// against better-auth@1.6.29 with the `organization` plugin. Hand edits to
// them are annotated inline; anything unannotated is generator output and
// should be regenerated rather than hand-maintained.
//
// `Organization` IS the tenant (CLAUDE.md C-8). Every tenant-scoped model
// carries `tenantId String` holding `organization.id` — a plain indexed
// column with no Prisma relation, per RESEARCH.md Pattern 3.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  // HAND-CORRECTED: emitted as `String?` because the Better Auth field is
  // declared `required: false`. Made NOT NULL so the single-owner Super Admin
  // marker (CLAUDE.md C-8) is a two-valued column, never a three-valued one —
  // a NULL platformRole is neither "merchant" nor "admin" and every future
  // authorization check would have to special-case it. Nothing writes this in
  // Phase 1; the DB default supplies it. Phase 6 reads it.
  platformRole  String       @default("merchant")
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// The tenant. One Organization == one storefront == one merchant's store.
model Organization {
  id        String   @id
  name      String
  // HAND-CORRECTED (assumption A2): the generator emitted a non-nullable
  // `slug String` plus a block-level `@@unique([slug])`. Normalized to the
  // inline form — identical DDL, but it puts the DOM-02 guarantee on the same
  // line as the column. NOT NULL + UNIQUE is what makes "one hostname can
  // never resolve to two stores" a database guarantee rather than an
  // application convention. Never relax either half.
  slug      String   @unique
  logo      String?
  createdAt DateTime
  metadata  String?
  // HAND-CORRECTED: emitted as `String?`. Made NOT NULL for D-05 — hostname
  // resolution branches on this value, and a NULL status is neither "active"
  // nor "suspended", so a row with one would resolve ambiguously. Declared
  // `input: false` in the Better Auth config, so it can never be set through
  // the public create/update API; suspension is a Phase 6 admin-only write.
  status    String   @default("active")

  /// SUB-01 / D-05: the merchant's chosen tier, one of `PLAN_TIERS` in
  /// `src/server/entitlements/plans.ts`. NULL means "signed up, has not picked
  /// a plan yet" and is the ONE place a nullable enum-ish column is correct in
  /// this schema — deliberately unlike the `status`/`platformRole` NOT NULL
  /// hand-corrections, where a third state had no meaning. Here the third state
  /// IS the D-01 flow, and exactly one gate handles it: the dashboard redirects
  /// a NULL-tier merchant to `/onboarding/plan`. Declared `input: false` in the
  /// Better Auth config, so no merchant can forge their own tier.
  planTier String?

  /// ONB-05: an optional override for a support-granted trial extension. NULL
  /// is the normal case and means "derive from `createdAt` + TRIAL_DAYS".
  /// Deriving rather than stamping means there is no window in which a
  /// just-created organization has no trial, and no second write that can fail
  /// and leave a merchant with no trial at all. `input: false`.
  trialEndsAt DateTime?

  /// D-09/D-10: "none" until a later phase builds the merchant subscribe-via-
  /// claim flow. NOT NULL for the same reason `status` was hand-corrected — no
  /// authorization check should have to special-case a third state, and
  /// `resolveEntitlements` compares this to the literal "active". `input: false`
  /// plus `defaultValue: "none"` in the Better Auth config satisfies the NOT
  /// NULL on insert without opening a public write path.
  subscriptionStatus String @default("none")

  /// D-06 audit breadcrumb: when the current tier was chosen or switched.
  /// Cheap to keep, and reconstructing tier history after the fact is
  /// impossible. NULL until the first plan selection. `input: false`.
  planSelectedAt DateTime?

  /// ONB-02 / D-02: the merchant's business segment, one of the six
  /// `INDUSTRY_SEGMENTS` in `src/server/theming/registry.ts`. NULL means the
  /// branding onboarding step is NOT DONE YET, and that third state is the
  /// gate itself — the redirect ladder sends a NULL-industry merchant to the
  /// branding step, exactly as a NULL `planTier` sends them to
  /// `/onboarding/plan`. Same "the third state IS the flow" reasoning that
  /// makes `planTier` the other correct nullable enum-ish column here.
  ///
  /// DELIBERATELY NOT the same thing as `StorefrontTheme.draftTemplateKey` /
  /// `.publishedTemplateKey` (D-03). Industry is what the merchant said their
  /// business is; the template key is what their storefront actually renders.
  /// Keeping them independent is what lets Phase 5 ship real segment
  /// templates without auto-migrating anyone.
  ///
  /// Declared `input: false` in the Better Auth organization
  /// `additionalFields`, so no request body can set it — the only writer is
  /// server-side branding code going through `platformDb`.
  industry String?

  /// SUB-03 (Phase 6): the end of the subscription period the platform owner's
  /// most recent confirmation paid for. NULL until the first confirmed
  /// `SubscriptionPaymentClaim`. Written only by the admin confirm path through
  /// `adminDb`; declared `input: false` in the Better Auth organization
  /// `additionalFields`, so no create/update body can reach it.
  ///
  /// STORED AND DISPLAYED ONLY IN THIS PHASE. `resolveEntitlements` is
  /// deliberately NOT taught to expire on this value here. Doing so would
  /// change `canWrite` semantics for every gated action in the product — every
  /// catalog write, every order transition, every theme publish — and that is
  /// tracked as `KD-V2-02` in STATE.md, the milestone's largest hidden cost.
  /// A future plan owns that change deliberately; nothing in Phase 6 may
  /// quietly start reading this column inside an entitlement decision.
  subscriptionCurrentPeriodEnd DateTime?

  members     Member[]
  invitations Invitation[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// Tenant-scoped models
//
// Every model below this line MUST be registered in TENANT_SCOPED_MODELS in
// `src/server/db/tenant-scoped.ts`, and MUST declare `tenantId String` —
// required, with no default. That is not a style preference: Prisma Client
// Extensions do not intercept nested writes (Pitfall 4), so a nested `create`
// on a tenant-scoped relation bypasses `scopedDb` entirely. A required
// `tenantId` turns that bypass into a compile-time type error, and a NOT NULL
// violation at worst — instead of a silent NULL row that a later read
// attributes to the wrong tenant.
// ---------------------------------------------------------------------------

/// Append-only record of which tenant has held which slug, and when.
///
/// This is the concrete artifact D-03 asks for. Slugs are renameable in
/// Phase 4, and without this table a rename releases the old slug for a
/// different merchant to claim — inheriting the original's inbound links, QR
/// codes and WhatsApp shares. That is a store-hijack window, not a cosmetic
/// gap.
///
/// Rename stays cheap because `tenantId` holds the stable `organization.id`:
/// a rename is an UPDATE of `organization.slug` plus a cache invalidation,
/// with no data migration anywhere.
model StoreSlugHistory {
  id String @id @default(cuid())

  /// `organization.id`. Required, no default — see the block comment above.
  tenantId String

  /// DELIBERATELY GLOBAL UNIQUE, not led by `tenantId`.
  ///
  /// This is the one intentional exception to the "every index leads with
  /// tenantId" rule (Pitfall 8), and the exception is the point: a slug is a
  /// hostname, so it must be unique across the entire platform for all time,
  /// including after release. Scoping this constraint to a tenant would let
  /// two tenants hold the same hostname, which is precisely the failure
  /// DOM-02 forbids.
  slug String @unique

  claimedAt  DateTime  @default(now())
  /// NULL means this tenant currently holds the slug.
  releasedAt DateTime?

  @@index([tenantId])
  @@index([tenantId, claimedAt])
  @@map("store_slug_history")
}

// ---------------------------------------------------------------------------
// Catalog / order / payment-claim enums (Phase 3)
//
// Enums are not models, so the "must be registered" rule above does not apply
// to them — but everything they are used by is tenant-scoped, so they live in
// this section rather than at the top of the file.
//
// Feature code may NOT import these from `@/generated/prisma*`:
// `eslint.config.mjs` bans that import outside `src/server/db/**`,
// `src/server/tenant/**` and `src/server/auth/**`, and that lint gate is the
// TEN-02/TEN-05 enforcement mechanism. `src/server/db/enums.ts` is the single
// sanctioned door (RESEARCH.md Pitfall 10).
// ---------------------------------------------------------------------------

/// The order lifecycle (ORD-01). Deliberately has NO `CANCELLED` member:
/// RESEARCH.md Open Question 1 resolved cancellation out of V1, and an enum
/// member no transition can reach is a state the machine must still defend
/// against forever.
enum OrderState {
  ORDER_PLACED
  PAYMENT_PENDING
  PAYMENT_CLAIMED
  CONFIRMED
  DISPUTED
  FULFILLED
}

/// How the order reached the merchant. Drives which payment instructions and
/// which confirmation path the order follows.
enum OrderChannel {
  WHATSAPP
  MANUAL_TRANSFER
  CASH_ON_DELIVERY
}

/// The two Cameroonian mobile-money operators V1 supports. No live PSP exists
/// in V1 — these name the rails the customer used, not an integration.
enum PaymentOperator {
  MTN_MOMO
  ORANGE_MONEY
}

/// Merchant verdict on a proof-of-payment claim (ORD-04).
enum ClaimStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// Who caused an `OrderEvent` (ORD-05). Repudiation defence: every state change
/// records an actor, so "the order changed state and nobody knows who" is not a
/// representable outcome.
enum EventActor {
  CUSTOMER
  MERCHANT
  SYSTEM
}

/// A merchant-defined product grouping (D-06). Free-form, unique within the
/// merchant only.
model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  slug      String
  createdAt DateTime @default(now())

  products Product[]

  @@unique([tenantId, id]) // enables the composite FK below
  @@unique([tenantId, slug]) // D-06: free-form but unique within the merchant
  @@index([tenantId])
  @@map("category")
}

model Product {
  id          String  @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?

  /// Whole XAF. No minor unit exists in common use, so no Decimal and no
  /// conversion. Overridable per variant.
  basePriceXaf Int

  /// D-08: deactivate-only. There is no delete path anywhere in this phase.
  active Boolean @default(true)

  /// D-05: at most two option axes. NULL means "this axis is unused".
  option1Name String?
  option2Name String?

  categoryId String?

  /// COMPOSITE FK (T-03-01). `references: [tenantId, id]` is what makes a
  /// forged cross-tenant `categoryId` a Postgres rejection rather than a
  /// convention the application is trusted to remember.
  ///
  /// `onDelete` is stated explicitly because it has to be: this relation is
  /// optional, so Prisma's default action would be `SetNull` — and `SetNull`
  /// is invalid here because one half of the FK (`tenantId`) is required and
  /// can never be nulled. `Restrict` is also the semantically correct choice
  /// under D-08: a category holding products is not disposable.
  category Category? @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)

  variants  ProductVariant[]
  images    ProductImage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, slug])
  @@index([tenantId, active])
  @@index([tenantId, categoryId])
  @@map("product")
}

model ProductVariant {
  id        String  @id @default(cuid())
  tenantId  String
  productId String
  /// `onDelete: Cascade` — a variant has no meaning without its product, and an
  /// orphan variant would hold stock nothing can sell. No application code in
  /// this phase deletes a product (D-08 is deactivate-only); this states what
  /// the database does if one is ever deleted, rather than leaving orphan rows
  /// possible.
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  /// EMPTY STRING, NOT NULL — see RESEARCH.md Pitfall 2. Postgres treats NULLs
  /// as distinct in a unique index, so two all-NULL variant rows would both be
  /// permitted and the matrix would silently accept duplicates.
  option1Value String @default("")
  option2Value String @default("")

  /// NULL inherits Product.basePriceXaf. Whole XAF.
  priceXaf Int?

  /// D-04 / CAT-03: the ONLY place stock lives. Every product has at least one
  /// variant row, so there is exactly one decrement code path.
  stock  Int     @default(0)
  sku    String?
  active Boolean @default(true)

  @@unique([tenantId, id])
  @@unique([tenantId, productId, option1Value, option2Value])
  @@index([tenantId, productId])
  @@map("product_variant")
}

model ProductImage {
  id        String  @id @default(cuid())
  tenantId  String
  productId String
  /// `onDelete: Cascade` — same reasoning as ProductVariant.
  product   Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  /// R2 object key prefix; derivative suffixes are appended by the pipeline.
  storageKey String

  /// D-10: 0 is the primary/hero image used everywhere a single thumbnail is
  /// needed.
  position  Int
  width     Int
  height    Int
  createdAt DateTime @default(now())

  @@unique([tenantId, productId, position])
  @@index([tenantId, productId])
  @@map("product_image")
}

model Order {
  id       String @id @default(cuid())
  tenantId String

  /// Short, typeable, read back over WhatsApp. nanoid over an unambiguous
  /// alphabet.
  orderNumber String
  state       OrderState
  channel     OrderChannel

  customerName    String
  customerPhone   String
  deliveryAddress String?
  customerNote    String?

  subtotalXaf Int
  totalXaf    Int

  /// D-12 / T-03-05. SHA-256 hex of the plaintext token. The plaintext is NEVER
  /// persisted, so a database read cannot yield a working tracking link.
  trackingTokenHash String

  /// Idempotent stock-hold marker — see RESEARCH.md Pattern 2b. Guards double
  /// release (Pitfall 6).
  stockHeld Boolean @default(false)

  items  OrderItem[]
  events OrderEvent[]
  claims PaymentClaim[]

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, orderNumber])
  /// Deliberately GLOBAL, like StoreSlugHistory.slug — a collision anywhere is
  /// a correctness bug, and the constraint costs nothing.
  @@unique([trackingTokenHash])
  @@index([tenantId, state, placedAt])
  @@map("order")
}

model OrderItem {
  id       String @id @default(cuid())
  tenantId String
  orderId  String
  /// `onDelete: Cascade` — a line item cannot outlive its order.
  order    Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  /// Plain columns, NOT relations. D-08 keeps products forever, but a merchant
  /// can rename or reprice one; an order must show what was actually bought at
  /// the price actually charged.
  productId    String
  variantId    String
  productName  String
  variantLabel String
  unitPriceXaf Int
  quantity     Int
  lineTotalXaf Int
  imageKey     String?

  @@index([tenantId, orderId])
  @@map("order_item")
}

/// ORD-05. APPEND-ONLY. Nothing in this codebase may update or delete a row
/// here.
model OrderEvent {
  id       String @id @default(cuid())
  tenantId String
  orderId  String
  /// `onDelete: Cascade` — the audit trail is scoped to the order it describes.
  order    Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  /// NULL only on the genesis event written by placeOrder.
  fromState OrderState?
  toState   OrderState
  actor     EventActor

  /// user.id when actor = MERCHANT. NULL for CUSTOMER and SYSTEM.
  actorUserId String?

  /// D-11: the merchant's rejection reason, shown to the customer.
  reason    String?
  createdAt DateTime @default(now())

  @@index([tenantId, orderId, createdAt])
  @@map("order_event")
}

model PaymentClaim {
  id       String @id @default(cuid())
  tenantId String
  orderId  String
  /// `onDelete: Cascade` — a claim cannot outlive the order it is a claim
  /// against.
  order    Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  operator PaymentOperator

  /// Exactly as the customer typed it — this is what the merchant compares
  /// against their SMS receipt.
  reference String

  /// ORD-04's actual uniqueness key. Uppercased, non-alphanumerics stripped.
  referenceNormalized String
  amountClaimedXaf    Int

  /// R2 object key. NULL when the customer skipped the optional screenshot.
  screenshotKey String?

  status           ClaimStatus @default(PENDING)
  rejectionReason  String?
  submittedAt      DateTime    @default(now())
  reviewedAt       DateTime?
  reviewedByUserId String?

  @@unique([tenantId, id])
  /// ORD-04 / T-03-04. A unique index cannot be raced; an application-level
  /// count() can.
  @@unique([tenantId, referenceNormalized])
  @@index([tenantId, status, submittedAt])
  @@index([tenantId, orderId])
  @@map("payment_claim")
}

/// D-14 / D-16. One row per tenant. Deliberately NOT columns on Organization:
/// Organization is Better Auth's generated model with `input: false` markers,
/// and these fields are merchant-editable, so they belong behind scopedDb and
/// merchantAction rather than behind a widened Better Auth write path.
model MerchantPaymentSettings {
  id String @id @default(cuid())

  /// SINGLE-FIELD `@unique`, not `@@unique([tenantId, …])`, so
  /// `findUnique({ where: { tenantId } })` and `upsert({ where: { tenantId } })`
  /// work directly and `scopedDb`'s upsert branch (which stamps both `where`
  /// and `create`) is enough. Do NOT add a second unique key.
  tenantId String @unique

  /// Normalized to 2376XXXXXXXX (no +, no spaces) for wa.me.
  whatsappNumber String?
  mtnMomoNumber  String?

  /// D-15: OPTIONAL. Present only for merchants registered for MTN MoMoPay.
  /// Six digits. Its presence is what unlocks the fully-parametrized tel: link.
  mtnMerchantCode   String?
  orangeMoneyNumber String?

  /// D-15: OPTIONAL. Orange's #150*47# takes no parameters, so this improves
  /// only the on-screen instructions, not the deep link.
  orangeMerchantCode String?

  codEnabled   Boolean @default(true)
  payoutNotice String?

  updatedAt DateTime @updatedAt

  @@map("merchant_payment_settings")
}

/// EDIT-01 / D-03. The tenant's theme instance: which template it was
/// instantiated from, its logo, and its brand tokens. ONE row per tenant,
/// which is why `tenantId` is a single-field `@unique` (same shape and same
/// reasoning as `MerchantPaymentSettings` above — `findUnique`/`upsert` on
/// `{ tenantId }` then work directly under `scopedDb`).
model StorefrontTheme {
  id String @id @default(cuid())

  /// `organization.id`. Required, no default — see the tenant-scoped block
  /// comment above. `@unique` because a tenant has exactly one theme.
  tenantId String @unique

  /// A key into `TEMPLATES` in `src/server/theming/registry.ts`. Never a
  /// foreign key to a Theme table: template *types* are code, exactly like
  /// `PLANS`, `IMAGE_PRESETS` and `ORDER_TRANSITIONS`.
  ///
  /// DELIBERATELY SEPARATE FROM `Organization.industry` (D-03). Industry is
  /// what the merchant said their business is; templateKey is what their
  /// storefront actually renders. Phase 5 ships real segment templates and
  /// MUST NOT auto-migrate anyone onto one — that is only expressible if the
  /// two are independent columns, and it is why this is stored rather than
  /// derived from `industry` at read time. Do not "simplify" this away.
  ///
  /// Split into draft/published (Phase 5, D-13) for the same reason every
  /// other mutable field on this row is split: the merchant previews a
  /// template switch and then publishes it, exactly as they do for their
  /// document (`StorefrontPage.draft`/`.published`) and their tokens
  /// (`draftTokens`/`publishedTokens` below). Writing `publishedTemplateKey`
  /// outside `publishStorefront` is a silent publish — the live customer-
  /// facing storefront would re-render under new variants the instant a
  /// merchant clicked, while `published` still held the old document.
  draftTemplateKey String @default("flagship-fashion")

  /// See `draftTemplateKey` above for the full rationale. This is the value
  /// `getPublishedStorefront` reads; `publishStorefront` is the only place
  /// permitted to set it (`publishedTemplateKey = draftTemplateKey`, inside
  /// its existing transaction).
  publishedTemplateKey String @default("flagship-fashion")

  /// The R2 derivative PREFIX (e.g. `tenants/{id}/logos/{uuid}`), matching
  /// `ProductImage.storageKey`'s convention. NEVER a full URL.
  ///
  /// This column exists INSTEAD OF `Organization.logo` on purpose. `logo` is a
  /// Better Auth CORE organization field, not an `additionalFields` entry:
  /// `baseUpdateOrganizationSchema` declares `logo: z.string().nullish()`
  /// (verified in
  /// `node_modules/better-auth/dist/plugins/organization/routes/crud-org.mjs`),
  /// so the `input: false` protection that keeps `planTier` and `status`
  /// server-only cannot apply to it — any signed-in merchant could POST an
  /// arbitrary string to `/organization/update` and overwrite it. Behind
  /// `scopedDb` here, the write path is server-controlled. `Organization.logo`
  /// is left unused and unwritten by this phase.
  logoKey String?

  /// D-08's draft/published split for the brand tokens:
  /// `{ primaryAccent, secondaryAccent }` as validated hex strings. Two
  /// columns on one row, not two tables — publish is then a single row write
  /// and a half-published state is not representable.
  draftTokens     Json
  publishedTokens Json

  /// NULL until the merchant publishes for the first time.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@map("storefront_theme")
}

/// EDIT-01. One row per (tenant, page), holding the FULL ordered section tree
/// as a document validated against `pageDocumentSchema`. `Json` maps to
/// `jsonb` on PostgreSQL.
///
/// `pageType` is `"home"` this phase; the column exists so that Phase 5 adds a
/// ROW, not a migration.
model StorefrontPage {
  id String @id @default(cuid())

  /// `organization.id`. Required, no default — see the tenant-scoped block
  /// comment above. NOT `@unique` on its own: a tenant owns many pages, and
  /// `@@unique([tenantId, pageType])` below is what makes exactly one row per
  /// (tenant, page) a database guarantee.
  tenantId String
  pageType String

  /// D-08. `draft` is always present; `published` is NULL until the first
  /// publish, and publishing is `published = draft` — one row, one statement,
  /// atomic by construction.
  draft     Json
  published Json?

  publishedAt    DateTime?
  /// Compared against `publishedAt` to answer "are there unpublished
  /// changes?", so it is set EXPLICITLY on every draft write rather than
  /// declared `@updatedAt` — an implicit clock read would make the comparison
  /// depend on write timing nobody controls.
  draftUpdatedAt DateTime  @default(now())
  createdAt      DateTime  @default(now())

  @@unique([tenantId, pageType])
  @@index([tenantId, pageType])
  @@map("storefront_page")
}

// ---------------------------------------------------------------------------
// Support thread / subscription claim enums (Phase 6)
//
// Same rule as the Phase 3 enum block above: enums are not models, so the
// "must be registered in TENANT_SCOPED_MODELS" obligation does not apply to
// them — but everything they are used by is tenant-scoped, so they live down
// here with it. Feature code reaches them through `src/server/db/enums.ts`,
// never through `@/generated/prisma*` (the lint gate is the TEN-02/TEN-05
// enforcement mechanism, not a style rule).
// ---------------------------------------------------------------------------

/// ADM-05. Who wrote a support message. Mirrors `EventActor`'s three-valued
/// shape deliberately: `SYSTEM` is what D-15's automatic suspension notice and
/// every later phase's automated notice are written as, so a merchant can tell
/// a human reply from a platform event at a glance. Collapsing `SYSTEM` into
/// `PLATFORM` would make an automated state change look like the platform
/// owner personally typed it.
enum SupportAuthor {
  MERCHANT
  PLATFORM
  SYSTEM
}

/// D-10 / D-22. TWO STORAGE CONTRACTS, ONE TABLE — discriminated so a reader
/// cannot confuse them.
///
/// `IMAGE` bytes are Sharp-re-encoded derivatives served PUBLICLY from
/// `R2_PUBLIC_BASE_URL` with no authentication (a capability URL, exactly like
/// a claim screenshot). `DOCUMENT` bytes cannot be re-encoded by Sharp, so they
/// are stored as uploaded and served ONLY through an authorized route handler
/// that sets its own content-disposition. Reading this column is how a caller
/// knows which of the two contracts a row is under; there is no way to infer it
/// from `storageKey` alone.
enum SupportAttachmentKind {
  IMAGE
  DOCUMENT
}

/// ADM-05 / D-07..D-13. One continuous per-merchant conversation between the
/// merchant and the platform owner.
///
/// THERE IS DELIBERATELY NO `SupportThread` MODEL. D-12 makes the thread "one
/// continuous conversation, never archived or closed", and there is exactly one
/// per organization — so a thread row would carry no state of its own. Its only
/// columns would be denormalized tallies and a most-recent-activity stamp, which
/// is precisely what `src/server/claims/queries.ts` argues against by name: a
/// number derived from the rows cannot drift from the rows. The thread IS
/// `SupportMessage WHERE tenantId = X ORDER BY createdAt`, and the admin inbox
/// is a `groupBy(["tenantId"])`.
///
/// DO NOT ADD A COUNTER COLUMN. Every tally this surface displays is derived at
/// read time. A cached tally here would be a second writer on a value the rows
/// already answer, and the first bug it produces is a badge nobody can explain.
model SupportMessage {
  id String @id @default(cuid())

  /// `organization.id`. ORGANIZATION-scoped, not user-scoped — the thread
  /// belongs to the store, so a future second staff account on the same
  /// organization inherits the whole conversation rather than starting a new
  /// one. Required, no default; see the tenant-scoped block comment above.
  tenantId String

  author SupportAuthor

  /// `user.id` for MERCHANT and PLATFORM. NULL for SYSTEM — the same
  /// nullable-actor contract `OrderEvent.actorUserId` carries, for the same
  /// reason: an automated message has no human to name, and inventing one
  /// would corrupt the audit reading of the thread.
  authorUserId String?

  /// Freeform. May be empty ONLY when the message carries an attachment, and
  /// that rule is enforced in the action's Zod schema rather than by the
  /// column — the constraint is "body OR attachment", which no single-column
  /// NOT NULL can express.
  body String

  /// Read receipts as TIMESTAMPS, not booleans. "When" is free to store and
  /// impossible to reconstruct after the fact. NULL means unread by that side.
  readByMerchantAt DateTime?
  readByPlatformAt DateTime?

  /// SUB-03: set when this message is the one that announced a subscription
  /// payment claim, so the thread can render the claim inline.
  ///
  /// DELIBERATELY NOT A RELATION. A claim may be reviewed from the admin ledger
  /// page with no message in scope at all, and a declared relation would invert
  /// that — it would make the message the claim's entry point rather than one
  /// of two independent ways in. NULL on every other message.
  subscriptionClaimId String?

  createdAt DateTime @default(now())

  attachments SupportAttachment[]

  @@unique([tenantId, id]) // enables SupportAttachment's composite FK below
  @@index([tenantId, createdAt]) // the thread read
  @@index([author, readByPlatformAt, createdAt]) // the admin inbox's unread scan
  @@map("support_message")
}

/// D-10 / D-22. Zero or more per message. A CHILD MODEL rather than a JSON
/// column on `SupportMessage`, matching `ProductImage`: the encoder reads
/// dimensions back and a JSON blob can neither be indexed nor constrained.
///
/// `kind`, `contentType`, `byteSize` and the nullable `width`/`height` are all
/// here from day one so plan 06-13's document path (D-22) needs no second
/// migration — a PDF has no raster dimensions, which is exactly why those two
/// columns are nullable rather than defaulted to zero.
model SupportAttachment {
  id        String @id @default(cuid())
  tenantId  String
  messageId String

  /// COMPOSITE FK on `(tenantId, messageId)`, same construction as
  /// `ProductImage.product`: a forged cross-tenant `messageId` is a Postgres
  /// rejection rather than a rule the application is trusted to remember.
  /// `onDelete: Cascade` — an attachment has no meaning without its message.
  message SupportMessage @relation(fields: [tenantId, messageId], references: [tenantId, id], onDelete: Cascade)

  kind SupportAttachmentKind

  /// WHAT THIS HOLDS DEPENDS ON `kind`, and that is the whole reason `kind`
  /// exists. For `IMAGE` it is the R2 derivative PREFIX (the pipeline appends
  /// the size suffixes), matching `ProductImage.storageKey`'s convention. For
  /// `DOCUMENT` it is the stored object key itself, because there are no
  /// derivatives to prefix. NEVER an `/original` key in either case, and never
  /// a full URL.
  storageKey String

  /// The served content type. Stored rather than derived from the key: the
  /// authorized `DOCUMENT` route handler must set it on the response, and
  /// guessing it from an extension is how a mislabelled download happens.
  contentType String

  /// Bytes, as verified at finalize time — not as claimed by the uploader.
  byteSize Int

  /// NULL for `DOCUMENT`. A PDF has no raster dimensions, and a zero would read
  /// as a real measurement rather than as an absent one.
  width  Int?
  height Int?

  createdAt DateTime @default(now())

  @@index([tenantId, messageId])
  @@map("support_attachment")
}

/// SUB-03. The manual-claim pattern with payer and payee reversed: the MERCHANT
/// is the payer, the PLATFORM OWNER is the judge.
///
/// DELIBERATELY NOT A DISCRIMINATED `PaymentClaim` (06-RESEARCH.md § Discretion
/// Q1). Three structural reasons, each of which would cost an existing
/// guarantee: `PaymentClaim.order` is a required composite FK and a
/// subscription claim has no order, so `orderId` would have to go nullable —
/// and a partially-required composite FK cannot use Prisma's default
/// `SetNull`; the uniqueness scope differs (per-tenant there, global here, and
/// one table cannot carry both); and `src/server/claims/actions.ts` is the
/// single sanctioned writer of a claim's `CONFIRMED` status, enforced by a
/// source-scanning test, so an admin-side confirm on that table would be
/// exactly the second writer the ORD-02 control forbids.
///
/// Field names echo `PaymentClaim` on purpose, so the shared pattern is
/// visible even though the tables are separate.
model SubscriptionPaymentClaim {
  id String @id @default(cuid())

  /// `organization.id`. Tenant-scoped, and read from BOTH sides: the merchant
  /// reads their own history through `scopedDb`, the platform owner reads the
  /// whole ledger through `adminDb`. That is not a contradiction — the admin
  /// surface's authorization comes from `requireAdminContext`, not from a
  /// tenant predicate.
  tenantId String

  operator PaymentOperator

  /// Exactly as the merchant typed it — this is what the platform owner
  /// compares against the platform account's own SMS receipt.
  reference String

  /// DELIBERATELY GLOBAL UNIQUE, unlike `PaymentClaim`'s
  /// `@@unique([tenantId, referenceNormalized])`.
  ///
  /// The difference is not an oversight, it follows from who the payee is.
  /// A customer claim is paid to the MERCHANT, so two customers of two
  /// different merchants may legitimately quote the same operator reference
  /// and duplicate detection is a per-merchant concern. A subscription claim
  /// is paid to the ONE platform account, so the same reference twice is the
  /// same payment twice, whoever sent it. Same global-constraint reasoning as
  /// `Order.trackingTokenHash` and `StoreSlugHistory.slug`.
  ///
  /// OBLIGATION THIS CREATES, recorded here so the handler is not written
  /// casually (T-06-11): a cross-tenant duplicate surfaces as a Prisma `P2002`,
  /// which is technically an existence oracle. It MUST be refused with one
  /// generic message that never names, hints at, or varies by the other tenant
  /// — the same posture `src/server/claims/actions.ts` takes for cross-tenant
  /// claim ids. Plan 06-15 owns that handler.
  referenceNormalized String @unique

  /// Whole XAF, like every other money column in this schema.
  amountXaf Int

  /// The tier this payment is for, SNAPSHOTTED at submit time as a plain
  /// string — not read from `Organization.planTier` at review time. Same
  /// snapshot doctrine as `OrderItem.productName`/`.unitPriceXaf`: a later
  /// plan change must never retroactively alter what a merchant already paid
  /// for, and a join to the live row at read time is exactly how it would.
  planTier String

  /// R2 derivative PREFIX, never an `/original` key. NULL when the merchant
  /// submitted no receipt image.
  receiptKey String?

  status          ClaimStatus @default(PENDING)
  rejectionReason String?

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?

  /// The platform owner's `user.id`. NULL until reviewed.
  reviewedByUserId String?

  /// The period end this confirmation produced, copied onto
  /// `Organization.subscriptionCurrentPeriodEnd` by the same write. NULL until
  /// confirmed. Kept on the claim as well as on the organization because the
  /// organization holds only the latest value, and reconstructing which
  /// payment bought which window afterwards is impossible.
  coversThrough DateTime?

  @@unique([tenantId, id])
  @@index([status, submittedAt]) // the admin ledger's own access path
  @@index([tenantId, submittedAt]) // the merchant's own history
  @@map("subscription_payment_claim")
}
